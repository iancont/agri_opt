# Librerías necesarias
library(ggplot2)
library(tidyr)
# Datos en formato data.frame
datos <- data.frame(
Años = c(2016, 2018, 2019, 2021, 2022),
Arroz = c(5924.25, 6204.18, 6284.79, 7900.40, 10006.78),
Platano_fomento = c(11054.87, 13492.85, 13052.38, 21329.88, 13669.17),
Platano_mantenimiento = c(8933.96, 9439.30, 9639.02, 22633.57, 12239.16),
Pollo = c(106.17, 106.17, 111.80, 156.52, 193.00),
Leche = c(15.72, 16.13, 16.73, 156.52, 193.00)
)
# Transformar los datos para que sean "long" (formato largo)
datos_largos <- datos %>%
pivot_longer(cols = -Años, names_to = "Rubros", values_to = "Costos")
# Gráfico de líneas con facetas
grafico <- ggplot(datos_largos, aes(x = Años, y = Costos, group = Rubros)) +
geom_line(size = 1, color = "black") +  # Líneas negras
geom_point(size = 2) +                  # Puntos
facet_wrap(~ Rubros, scales = "free_y") + # Facetas por rubro con escalas independientes en Y
labs(
title = "Evolución de los Costos por Rubro Agrícola",
x = "Años",
y = "Costos (en RD$)",
caption = "Fuente: Ministerio de Agricultura"
) +
theme_minimal(base_size = 14) +        # Fondo blanco
theme(
plot.caption = element_text(hjust = 0, face = "italic"),
strip.text = element_text(size = 12, face = "bold"), # Títulos de las facetas
panel.grid.major = element_line(color = "gray80"),   # Líneas de la cuadrícula suaves
panel.grid.minor = element_blank()                  # Sin líneas menores
)
# Mostrar el gráfico
print(grafico)
